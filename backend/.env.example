# ==========================================
# Virtual Autopsy Online Training LMS
# Backend Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication & Session Security (Replace with custom 64-char random strings)
JWT_SECRET=vat_jwt_super_secret_dev_key_change_in_production_9988776655
JWT_EXPIRES_IN=7d
COOKIE_SECRET=vat_cookie_secret_dev_key_change_in_production_1122334455

# 1. Database (PostgreSQL via Supabase or Local)
# For local development, e.g.: postgresql://postgres:postgres@localhost:5432/vat_lms?schema=public
# For Supabase cloud:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. File & Image Storage (Cloudflare R2 - S3 Compatible)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=vat-lms-files
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# 3. Video Storage, Streaming & DRM (Bunny.net Stream)
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key
BUNNY_STREAM_TOKEN_KEY=your_token_authentication_security_key
BUNNY_STREAM_PULL_ZONE=vz-xxxxxx.b-cdn.net

# 4. Transactional Email Notifications (Brevo / Sendinblue)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=admin@virtualautopsylms.com
BREVO_SENDER_NAME="Virtual Autopsy LMS"

# 5. Cache & Background Queue (Upstash Redis)
REDIS_URL="rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379"
